#!/usr/bin/env php
<?php

// Cookie of the debug mode (ADT\DebugToken), run by `make debug-token` of adt/make in a throwaway
// container without network; the signature itself is made on the host by ssh-keygen and ssh-agent.
//   debug-token message <expiry> <host>          prints the text to sign
//   debug-token token <expiry> <host> < sshsig   prints the cookie nette-debug

declare(strict_types=1);

require __DIR__ . '/../src/DebugToken.php';

use ADT\DebugToken;

try {
	$expiry = (int) ($argv[2] ?? 0);
	$host = DebugToken::normalizeHost($argv[3] ?? '');
	switch ($argv[1] ?? '') {
		case 'message':
			echo DebugToken::message($expiry, $host);
			break;

		case 'token':
			$token = DebugToken::create($expiry, $host, (string) stream_get_contents(STDIN));
			$where = $host === DebugToken::AnyHost ? 'všechny domény' : $host;
			echo "Cookie nette-debug pro $where, platí do ", date('j. n. Y H:i e', $expiry), ":\n\n$token\n";
			break;

		default:
			fwrite(STDERR, "Usage: debug-token message <expiry> <host> | token <expiry> <host> < sshsig\n");
			exit(2);
	}
} catch (InvalidArgumentException $e) {
	fwrite(STDERR, $e->getMessage() . "\n");
	exit(1);
}
