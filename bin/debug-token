#!/usr/bin/env php
<?php

// Developer key and cookie of the debug mode (ADT\DebugToken), run by `make debug-key` and
// `make debug-token` of adt/make in a throwaway container without network. The key file comes on stdin.
//   debug-token new <slug>              prints the line of a new key file
//   debug-token public < key            prints the line for APP_DEVELOPERS
//   debug-token token <host> <hours> < key   prints the cookie nette-debug for the host

declare(strict_types=1);

require __DIR__ . '/../src/DebugToken.php';

use ADT\DebugToken;

try {
	switch ($argv[1] ?? '') {
		case 'new':
			echo DebugToken::newKeyPair($argv[2] ?? '')[1], "\n";
			break;

		case 'public':
			echo DebugToken::publicKeyLine((string) stream_get_contents(STDIN)), "\n";
			break;

		case 'token':
			$host = DebugToken::normalizeHost($argv[2] ?? '');
			$hours = (int) ($argv[3] ?? 12);
			$token = DebugToken::create((string) stream_get_contents(STDIN), $host, $hours * 3600);
			echo "Cookie nette-debug pro $host, platí $hours h:\n\n$token\n\n",
				"Do konzole prohlížeče na https://$host/:\n\n",
				"document.cookie = 'nette-debug=$token; path=/; max-age=", $hours * 3600, "; secure; samesite=strict';\n";
			break;

		default:
			fwrite(STDERR, "Usage: debug-token new <slug> | public < key | token <host> <hours> < key\n");
			exit(2);
	}
} catch (InvalidArgumentException $e) {
	fwrite(STDERR, $e->getMessage() . "\n");
	exit(1);
}
