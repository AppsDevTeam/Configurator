<?php

declare(strict_types=1);

// Default error page of production (Debugger::$errorTemplate set by ADT\Bootstrap::bootUI(), a project
// overrides it with app/error.phtml). Only errors the errorPresenter did not handle get here
// (an exception in the error presenter itself, a fatal error), so it is always the 500 page - Tracy
// does not pass the exception to the template.

$title = 'To se nemělo stát :(';
$content = 'Omlouváme se, ale při zpracování Vašeho požadavku nastala chyba. Zkuste to, prosím, později.';

if (!empty($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest') {
	echo $content;
	exit;
}

$html = <<<EOL
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset='utf-8'>
<meta name='robots' content='noindex,nofollow'>
<title>$title</title>

<style>
	#tracy-error { all: initial; position: absolute; top: 0; left: 0; right: 0; height: 70vh; min-height: 400px; display: flex; align-items: center; justify-content: center; z-index: 1000 }
	#tracy-error div { all: initial; max-width: 550px; background: white; color: #333; display: block }
	#tracy-error h1 { all: initial; font: bold 50px/1.1 sans-serif; display: block; margin: 40px }
	#tracy-error p { all: initial; font: 20px/1.4 sans-serif; margin: 40px; display: block }
	#tracy-error small { color: gray }
</style>
</head>
<body>
<div id=tracy-error>
	<div>
		<h1>$title</h1>

		<p>$content</p>

		<p><small>chyba 500</small></p>
	</div>
</div>
</body>
</html>
EOL;

// Part of the page is already sent: close whatever element is open and replace the page by JavaScript
if (headers_sent()) {
	$html = str_replace('</script>', '<\/script>', $html);

	echo '</textarea></script></style></pre></xmp></a></audio></button></canvas></datalist></details></dialog></iframe></listing></meter></noembed></noframes></noscript></optgroup></option></progress></rp></select></table></template></title></video>';
	echo "<script>
		/*<!--*/
		document.querySelector('html').innerHTML = `$html`;
		/*-->*/
		</script>
	";
} else {
	echo $html;
}

exit;
